# Copy to .env

# ------------------------------------------------------------
# TEXT / GEMINI
# ------------------------------------------------------------
# real = use Gemini API
# mock = local deterministic mode for testing without API keys
GEMINI_MODE=real

GEMINI_API_KEY=your_gemini_api_key_here

# Current configurable model IDs.
GEMINI_OUTLINE_MODEL=gemini-3.8-flash
GEMINI_STORY_MODEL=gemini-3.1-pro-preview

# ------------------------------------------------------------
# IMAGE GENERATION
# ------------------------------------------------------------
# huggingface = hosted inference
# local = Diffusers on your computer
# placeholder = local test images, no image API required
IMAGE_PROVIDER=huggingface

HF_TOKEN=your_huggingface_token_here
HF_PROVIDER=auto
HF_IMAGE_MODEL=runwayml/stable-diffusion-v1-5

# Local Diffusers model
LOCAL_IMAGE_MODEL=runwayml/stable-diffusion-v1-5

IMAGE_WIDTH=768
IMAGE_HEIGHT=768
IMAGE_STEPS=20
IMAGE_GUIDANCE=7.5
